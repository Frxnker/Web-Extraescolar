.gitignore
# --- Dependencias ---
node_modules/
bower_components/
vendor/

# --- Variables de entorno (Seguridad) ---
.env
.env.local
.env.*.local
*.env
config.php
credentials.json

# --- Archivos del Sistema ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs y Temporales ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.tmp/
.cache/

# --- Compilación y Salida ---
dist/
build/
out/
.next/
.serverless/

# --- Editores de código ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Bases de Datos ---
*.db
*.sqlite
